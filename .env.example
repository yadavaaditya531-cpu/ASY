# Copy to .env.local. Everything is optional for a local try-out.

# Enables "Write draft" and AI campaigns.
ANTHROPIC_API_KEY=

# Require this password to open the app. Set it whenever the app is reachable by others.
APP_PASSWORD=

# Key used to encrypt stored account credentials. If unset, a random one is created in data/secret.key.
# Changing it makes already-connected accounts unreadable (reconnect them).
APP_SECRET=

# Bearer token for GET /api/cron (only needed where no long-running server process exists).
CRON_SECRET=

# Where the SQLite database lives. Defaults to ./data
DATA_DIR=
